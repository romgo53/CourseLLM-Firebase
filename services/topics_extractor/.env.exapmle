# Example environment variables for topics_extractor
PORT=8000
LOG_LEVEL=info

# If you later add API keys for model providers, add them here (e.g. OPENAI_API_KEY)

LM_API_KEY=LLM_API_KEY_VALUE
LM_MODEL=the model you are using
FIREBASE_SERVICE_ACCOUNT_JSON=FIRE_BASE_SERVICE_ACCOUNT_JSON_VALUE

USE_EMULATOR=true # For dev only

# For dev only
FIREBASE_AUTH_EMULATOR_HOST=host.docker.internal:9099
FIRESTORE_EMULATOR_HOST=host.docker.internal:8080
FIREBASE_STORAGE_EMULATOR_HOST=host.docker.internal:9199

# Sentry configuration
USE_SENTRY=false # Set to true to enable Sentry error tracking
SENTRY_DSN=your_sentry_dsn_here
